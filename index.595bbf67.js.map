"use strict";
var body = document.querySelector("body");
var list = body.querySelector("ul.tree");
list.addEventListener("click", function(e) {
    if (e.target.tagName === "SPAN") {
        var currentLi = e.target.closest("li");
        var currentUl = currentLi.querySelector("ul");
        if (currentUl.style.display === "none") currentUl.style.display = "";
        else currentUl.style.display = "none";
    }
});
function listShowHideFichure(node) {
    var childCollection = node.querySelectorAll("li");
    // Abbriviation of empty text
    childCollection.forEach(function(li) {
        if (li.querySelector("ul")) {
            var span = document.createElement("span");
            span.textContent = li.firstChild.textContent;
            li.firstChild.textContent = "";
            li.prepend(span);
        }
    });
}
listShowHideFichure(list);

